# GIRZOCK Technologies: front controller and web-root hardening
Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Production only: uncomment after HTTPS is available.
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    # RewriteCond %{HTTP_HOST} ^www\.girzock\.com$ [NC]
    # RewriteRule ^ https://girzock.com%{REQUEST_URI} [L,R=301]

    # Source, configuration and documentation are never served.
    RewriteRule ^(application|system|database|docs)(/|$) - [F,L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteRule \.(sql|md|rst|env|log|ini|lock|bak|example)$ - [F,L]
    RewriteRule ^(license\.txt|composer\.(json|lock))$ - [F,L]

    # Serve a WebP copy of an image when the browser accepts it and a copy exists.
    # The original PNG or JPEG stays in place. Build the copies with database/tools/build_webp.php.
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME}.webp -f
    RewriteRule ^(assets/images/.+\.(?:png|jpe?g))$ $1.webp [T=image/webp,L]

    # Everything that is not a real file goes to CodeIgniter.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # X-Frame-Options comes from PHP: SAMEORIGIN on public pages and DENY in the admin panel.
    Header always unset X-Powered-By
    Header unset X-Powered-By
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    <FilesMatch "\.(css|js|png|jpe?g|gif|webp|svg|woff2?|ttf|eot|ico|mp4)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # The same image URL can return PNG or WebP, so caches must keep them apart.
    <FilesMatch "\.(png|jpe?g|webp)$">
        Header merge Vary Accept
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

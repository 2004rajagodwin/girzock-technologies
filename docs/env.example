# Copy to  <parent of project>/girzock-private/.env  (outside the public web root).
# Never commit the real file. Use different values on every environment.

# development | production   (production hides all error detail from visitors)
APP_ENV=development
BASE_URL=http://localhost/girzock-website/
# Used for canonical URLs, sitemap and structured data. Leave blank to use BASE_URL.
PUBLIC_URL=

DB_HOST=localhost
DB_NAME=girzock_technologies
DB_USER=root
DB_PASS=

# Two different random values, 64 hex characters each. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ENCRYPTION_KEY=
SECRET_BOX_KEY=

# Force the Secure flag on cookies. Set to 1 once the site is served over HTTPS.
COOKIE_SECURE=0

# SMTP defaults. Host, port, user and sender can be overridden in Admin > Website Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_CRYPTO=tls

# PHP and the database session both use this timezone.
APP_TIMEZONE=Asia/Kolkata
